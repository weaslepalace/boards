	(text "Inductor Selection\n------------------\nI_{IN(MAX)} = V_{OUT} * I_{LOAD(MAX)} / (V_{IN} * %_{EFF})\ndI = %_{RIPPLE} * I_{IN(MAX)}\nL = ((V_{IN} * (V_{OUT} - V_{IN})) / (V_{OUT} * f_{SW} * dI)\n\nWhere:\nV_{OUT} is 24V\nV_{IN} is 5V\nf_{SW} is 1MHz\nI_{LOAD(MAX)} is 100mA\n%_{EFF} is 80%\n%_{RIPPLE} is 33%\n\nThus:\nI_{IN(MAX)} is 545mA\ndI is 180mA\nL is 22uH\n"
		(exclude_from_sim yes)
		(at 205.994 31.242 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 194 0 1)
			)
			(justify left)
		)
		(uuid "45f37964-924e-410e-a771-8adcc14e6f43")
	)
	(text "Feedback Selection\n-------------------\nR1 = R2 * (V_{OUT} - V_{FB}) / V_{FB}\n\nWhere:\nV_{FB} is 1.23V\nV_{OUT} is 24V\nR_{2} is 10k\n\nThus:\nR_{1} is 18.2k (Closest standard value)\nV_{OUT} becomes 23.6V (Close enough)\n"
		(exclude_from_sim yes)
		(at 253.492 99.568 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 194 0 194 1)
			)
			(justify left)
		)
		(uuid "6af19c80-c593-435f-911a-a7ebf941988c")
	)
